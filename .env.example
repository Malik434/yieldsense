# ─── Processor runtime environment ───────────────────────────────────────────
# Injected into the Acurast Cargo job via _STD_.environment (encrypted on-chain).
# For local dev, copy to .env and fill in values.

# The user's wallet address — baked into the bundle at deploy time by /api/deploy.
# In production this is injected via esbuild define, not this file.
USER_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed YieldSenseKeeper contract address
KEEPER_ADDRESS=0x0000000000000000000000000000000000000000

# Stable processor authorization registry.
EXECUTOR_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Chain ID (84532 = Base Sepolia, 8453 = Base Mainnet)
# Must match CHAIN_ID in the frontend/.env
CHAIN_ID=8453

# ─── Deployment ───────────────────────────────────────────────────────────────
# RPC endpoints
BASE_MAINNET_RPC=https://mainnet.base.org
RPC_URL=https://sepolia.base.org

# Private key of the DEPLOYER wallet (temporary hot wallet for deployment ONLY).
# Must be funded with Base ETH for gas. NEVER reuse this as the protocol owner.
# NEVER commit a real key. Rotate and zero this wallet after deployment.
DEPLOYER_PRIVATE_KEY=0xdeadbeef_REPLACE_WITH_FUNDED_DEPLOYER_KEY

# Optional testing owner override. Leave blank to keep the deployer EOA as owner.
# Later, this can be set to a Safe and accepted through Ownable2Step.
# PROTOCOL_OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Acurast processor Ethereum addresses. Register these in ExecutorRegistry with
# PROCESSOR_ROLE=YIELD_EXECUTOR or PROCESSOR_ROLE=GRID_EXECUTOR.
YIELD_PROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000
GRID_PROCESSOR_ADDRESS=0x0000000000000000000000000000000000000000

# BaseScan API key for contract verification.
# Obtain from https://basescan.org/myapikey
BASESCAN_API_KEY=REPLACE_WITH_BASESCAN_KEY


# ─── Acurast Processor runtime ────────────────────────────────────────────────
# RPC endpoint for reading on-chain price data
DATA_RPC_URL=https://mainnet.base.org

# Frontend URL for fetching signed strategy params from /api/strategy
FRONTEND_URL=https://your-deployment.netlify.app

# Telemetry endpoint (defaults to FRONTEND_URL/api/telemetry if not set)
# TELEMETRY_URL=https://your-deployment.netlify.app/api/telemetry
# Telemetry verbosity: standard = production signal, debug = all RPC/stage events, essential = only lifecycle/tx events.
TELEMETRY_DETAIL=standard

# Shared secret for telemetry API authentication.
# Must match PROCESSOR_SHARED_SECRET in the frontend/.env.
# Generate: openssl rand -hex 32
PROCESSOR_SHARED_SECRET=change_me_generate_with_openssl_rand_hex_32

# Deployed processor defaults to API-only APR consensus to avoid heavy eth_getLogs
# in constrained TEE runtimes. DefiLlama is disabled by default because its
# /pools response is large and can exceed short processor execution windows.
YIELD_FALLBACK_MODE=api
APR_API_TIMEOUT_MS=3500
ENABLE_DEFILLAMA_APR=false

# Fast Acurast mode submits quickly but can still emit a single API APR estimate.
# "api" uses one HTTP APR source and avoids RPC-heavy indexing; "skip" restores
# the previous zero-yield fast-submit behavior.
ACURAST_FAST_SUBMIT=true
ACURAST_FAST_YIELD_MODE=api
ACURAST_FAST_YIELD_SOURCE=geckoTerminal
ACURAST_FAST_YIELD_TIMEOUT_MS=3500

# Optional Base/CDP Paymaster mode for sponsored Acurast harvest gas.
# Default "native" uses Acurast _STD_.chains.ethereum.fulfill and requires the
# hardware processor address to hold Base ETH. "paymaster" submits an ERC-4337
# UserOperation from a Coinbase Smart Account controlled by the Acurast signer.
# In paymaster mode, register the reported smartAccountAddress in ExecutorRegistry,
# because the keeper sees msg.sender as the smart account.
GAS_SPONSOR_MODE=native
# BASE_PAYMASTER_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base/YOUR_CDP_KEY
# Optional stable owner key for one reusable sponsored smart account across
# Acurast deployments. Treat as a hot automation key and restrict paymaster policy.
# PAYMASTER_OWNER_PRIVATE_KEY=0xREPLACE_WITH_DEDICATED_AUTOMATION_KEY
# Use once to emit paymaster_smart_account_report without submitting harvest.
PAYMASTER_DISCOVERY_ONLY=false
PAYMASTER_RPC_TIMEOUT_MS=20000
PAYMASTER_WAIT_TIMEOUT_MS=120000

# Startup RPC probes are useful locally, but can waste the short Acurast
# execution window when a public RPC stalls. Leave false for deployed jobs.
STARTUP_RPC_PROBE=false
RPC_STARTUP_TIMEOUT_MS=4000
YIELD_ESTIMATE_TIMEOUT_MS=12000
PROCESSOR_EXECUTION_BUDGET_MS=50000
PROCESSOR_SHUTDOWN_GRACE_MS=8000
RUN_COOLDOWN_GUARD=true
MIN_RUN_INTERVAL_MS=600000
KEEPER_READ_TIMEOUT_MS=4000
FEE_DATA_TIMEOUT_MS=4000
FEE_WINDOW_SEC=900
FEE_MAX_BLOCKS=300
LOG_CHUNK_SIZE=150
RPC_CALL_TIMEOUT_MS=4000
RPC_LOG_TIMEOUT_MS=4000
RPC_REQUEST_TIMEOUT_MS=6000
RPC_CHUNK_DELAY_MS=25

# Uniswap/Aerodrome V3 pool address for price data
# Default: WETH/USDC 0.05% on Base mainnet
UNISWAP_POOL_ADDRESS=0xb2cc224c1c9fee385f8ad6a55b4d94e92359dc59

# Decimal correction factor for sqrtPriceX96 → USD price.
# WETH/USDC (18 dec / 6 dec): 10^(18-6) = 1e12
POOL_DECIMAL_FACTOR=1e12

# ─── Legacy / Acurast worker key (testnet only) ────────────────────────────────
# NEVER use this on mainnet. Use DEPLOYER_PRIVATE_KEY for deployment.
ACURAST_WORKER_KEY=0xdeadbeef_TESTNET_ONLY

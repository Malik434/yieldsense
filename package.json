{
  "name": "yieldsense",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "build": "node scripts/generateAcurastEnv.cjs && webpack",
    "build:acurast": "node scripts/generateAcurastEnv.cjs --include-secret && webpack",
    "build:embed": "node scripts/generateAcurastEnv.cjs && webpack && node scripts/embedProcessor.cjs",
    "build:all": "npm run build:embed && npm run build --prefix frontend",
    "start": "webpack-dev-server --mode development",
    "test:pools": "tsx src/poolSmoke.ts",
    "test:mainnet-processor": "node scripts/smokeMainnetProcessor.cjs",
    "test:acurast-mobile": "node scripts/smokeAcurastMobile.cjs",
    "smoke:yield": "node scripts/smokeYieldVaultMainnet.cjs",
    "smoke:yield:pool": "node scripts/smokeYieldPoolMainnet.cjs",
    "smoke:grid": "node scripts/smokeGridVaultMainnet.cjs",
    "recover:grid": "npx hardhat run scripts/recoverGridStrategyMainnet.cjs --network baseMainnet",
    "upgrade:grid": "npx hardhat run scripts/upgradeGridMainnet.cjs --network baseMainnet",
    "enable:grid:acu": "npx hardhat run scripts/enableGridAcuMainnet.cjs --network baseMainnet",
    "dev": "node --env-file=.env dist/index.bundle.cjs",
    "dev:processor": "node --env-file=.env dist/processor.bundle.cjs",
    "rpc:relay": "node scripts/rpcRelay.cjs",
    "print:acurast-env": "node scripts/printAcurastConfigEnv.cjs",
    "verify:lp": "node scripts/verifyLpPosition.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.16.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "chai": "^4.5.0",
    "hardhat": "^2.20.0",
    "ts-loader": "^9.5.7",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "webpack": "^5.106.0",
    "webpack-cli": "^7.0.2"
  }
}
